
# Ключ API DeepSeek (обязательно для проверки с моделью)
LLM_API_KEY=

# Необязательно:
# LLM_PROVIDER=deepseek          # deepseek (по умолчанию) или qwen
# LLM_MODEL=deepseek-v4-pro      # модель по умолчанию для DeepSeek
# LLM_BASE_URL=                  # для qwen обязателен: https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
